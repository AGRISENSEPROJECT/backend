# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
TYPEORM_SYNCHRONIZE=false

# Database Configuration
# Preferred for production/external DBs (Neon, Render, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_SSL=true

# Local database fallback (used when DATABASE_URL is not set)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres123
DATABASE_NAME=agrisense

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Seed admin (used by: yarn seed:admin)
ADMIN_EMAIL=admin@agrisense.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!

# Email Configuration (Brevo HTTP API - works on Render)
BREVO_API_KEY=your-brevo-api-key-here

# Cloudinary Configuration (for profile images)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Model API Integration
MODEL_API_URL=http://127.0.0.1:5000
MODEL_PREDICT_PATH=/predict
MODEL_API_TIMEOUT_MS=30000

# Flutterwave Payments (mobile money / card checkout)
# Get keys from https://dashboard.flutterwave.com
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxx
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxx
# Secret hash configured in Flutterwave Dashboard → Settings → Webhooks
FLW_WEBHOOK_HASH=your-random-webhook-hash
# Frontend callback page that reads ?status&tx_ref&transaction_id
# then calls POST /api/payments/verify
# FRONTEND_URL is reused for redirect: {FRONTEND_URL}/payments/callback
